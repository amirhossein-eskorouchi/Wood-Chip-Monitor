# Wood-Chip Monitor runtime data
# ------------------------------------------------------------
/data/
/outputs/


# ------------------------------------------------------------
# Local model-artifact storage
#
# The source/model definitions in models/ are tracked, but trained
# weights and deployment/export artifacts should remain local.
# ------------------------------------------------------------
/models/artifacts/


# ------------------------------------------------------------
# Machine-learning model artifacts
# ------------------------------------------------------------
*.engine
*.onnx
*.pt
*.pth
*.ckpt
*.trt
*.plan
*.weights

# TensorFlow / Keras model artifacts
*.h5
*.hdf5
*.keras

# Additional deployment/model formats
*.tflite
*.pb
*.uff


# ------------------------------------------------------------
# Intermediate numerical outputs
# ------------------------------------------------------------
*.npy
*.npz
*.pkl
*.pickle

cache/


# ------------------------------------------------------------
# Large media
# ------------------------------------------------------------
*.mp4
*.avi
*.mov
*.mkv


# ------------------------------------------------------------
# Archives
# ------------------------------------------------------------
*.zip
*.7z
*.rar
*.tar
*.tar.gz


# ------------------------------------------------------------
# Research papers, reports, and manuscript PDFs
#
# Publications and project reports should be linked from the
# repository rather than stored as binary PDFs.
# ------------------------------------------------------------
*.pdf


