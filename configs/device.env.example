# ============================================================
# Wood-Chip Monitor device configuration
# ============================================================
#
# Copy this file to a local deployment configuration and
# customize values for the target Jetson device.
#
# Do not commit credentials or machine-specific secrets.
# ============================================================


# ------------------------------------------------------------
# Device identity
# ------------------------------------------------------------

WOODCHIP_DEVICE_ID=woodchip-monitor-01


# ------------------------------------------------------------
# Administrator bootstrap
# ------------------------------------------------------------
# Required only when initializing a database with no users.

WOODCHIP_ADMIN_EMAIL=admin@example.com
WOODCHIP_ADMIN_PASSWORD=change-this-password


# ------------------------------------------------------------
# Camera
# ------------------------------------------------------------

WOODCHIP_CAMERA_DEVICE=/dev/video0
WOODCHIP_CAMERA_WIDTH=1480
WOODCHIP_CAMERA_HEIGHT=900
WOODCHIP_CAMERA_FPS=20


# ------------------------------------------------------------
# Model artifacts
# ------------------------------------------------------------
# Defaults point to the repository's models/ directory.
# Uncomment these only when models are stored elsewhere.

# WOODCHIP_MODEL_DIR=/absolute/path/to/models
# WOODCHIP_DETR_ENGINE=/absolute/path/to/detr_resnet101_fp16.engine
# WOODCHIP_MOISTURE_ENGINE=/absolute/path/to/moistnetlite_fp16.engine
# WOODCHIP_MOISTURE_CLASSES=/absolute/path/to/moistnetlite_classes.txt


# ------------------------------------------------------------
# Runtime storage
# ------------------------------------------------------------

# WOODCHIP_DB_PATH=/absolute/path/to/woodchip_app.sqlite3
# WOODCHIP_OUTPUT_DIR=/absolute/path/to/live_outputs